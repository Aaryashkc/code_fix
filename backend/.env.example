# ============================================================================
# YATRA API - ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env and fill in real values. Never commit .env to git.
# ============================================================================

# ----------------------------------------------------------------------------
# CORE SERVER
# ----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ----------------------------------------------------------------------------
# DATABASE (MongoDB Atlas)
# ----------------------------------------------------------------------------
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority&appName=yourapp

# ----------------------------------------------------------------------------
# AUTHENTICATION
# ----------------------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRE=7d

# ----------------------------------------------------------------------------
# CORS - Comma-separated allowed origins
# ----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# RATE LIMITING
# windowMs: Time window in ms | max: Requests per window per IP
# ----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Auth-specific limiter (non-GET /api/auth requests, successful requests are skipped)
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=50

# ----------------------------------------------------------------------------
# SMTP - Optional; required only for email and OTP delivery
# Generate at: https://myaccount.google.com/apppasswords
# ----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@yatra.com

# ----------------------------------------------------------------------------
# ESEWA PAYMENT GATEWAY (Optional test environment)
# Docs: https://developer.esewa.com.np/
# ----------------------------------------------------------------------------
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_PAYMENT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://uat.esewa.com.np/api/epay/transaction/status/

# ----------------------------------------------------------------------------
# CLOUDINARY (Image Uploads)
# ----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ----------------------------------------------------------------------------
# AI ITINERARY GENERATION
# ----------------------------------------------------------------------------
# Provider order:
# - auto: tries OpenRouter free, then local Ollama, then OpenAI, then heuristic fallback
# - or specify comma-separated order like: openrouter,ollama,heuristic
AI_PROVIDER=auto

# OpenRouter free option (hosted, zero-cost models router)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=Yatra

# Ollama free local option
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Optional paid OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
